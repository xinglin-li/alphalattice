"""Telemetry names generated by Weaver from config/telemetry. Do not edit."""

from typing import Final

ALPHALATTICE_ATTRIBUTE_PREFIX: Final = {{ ctx.prefix | tojson }}
{% for attr in ctx.attributes %}
{{ attr.key | upper | replace(".", "_") | replace("-", "_") }}: Final = {{ attr.key | tojson }}
{%- endfor %}

{%- for span in ctx.spans %}
SPAN_{{ span | upper | replace(".", "_") }}: Final = {{ span | tojson }}
{%- endfor %}

{%- for event in ctx.events %}
EVENT_{{ event | upper | replace(".", "_") }}: Final = {{ event | tojson }}
{%- endfor %}

{%- for operation in ctx.operations %}
GEN_AI_OPERATION_{{ operation | upper }}: Final = {{ operation | tojson }}
{%- endfor %}
