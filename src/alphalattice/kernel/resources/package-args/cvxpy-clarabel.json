    {"schema_version": "1", "name": "tol_feas", "value_kind": "number", "has_default": true, "default": 0.00000001, "minimum": 0.0, "minimum_inclusive": false},
    {"schema_version": "1", "name": "tol_gap_abs", "value_kind": "number", "has_default": true, "default": 0.00000001, "minimum": 0.0, "minimum_inclusive": false},
    {"schema_version": "1", "name": "tol_gap_rel", "value_kind": "number", "has_default": true, "default": 0.00000001, "minimum": 0.0, "minimum_inclusive": false},
